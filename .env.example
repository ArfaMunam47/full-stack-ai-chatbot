# ==============================================================================
# ARFA AI — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Note: Placeholders only. Never commit real secrets or credentials.
# ==============================================================================

# AI Providers (Server-Side Only - Never expose to client)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Default AI Provider)
GEMINI_API_KEY=

# OpenAI API Key (Optional secondary provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Default provider: "gemini" or "openai"
DEFAULT_MODEL_PROVIDER=gemini

# Application & Session Security
# ------------------------------------------------------------------------------
# Secret for signing cookies and session tokens (generate a 32+ char random string)
SESSION_SECRET=
NODE_ENV=production

# Application URL (Canonical production URL on Netlify or custom domain)
APP_URL=https://arfa-ai.netlify.app

# Database & Supabase Configuration (Optional Production Cloud Database)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=
# Public anonymous key for client/browser queries with Row Level Security (RLS)
SUPABASE_ANON_KEY=
# Elevated Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=
# Direct PostgreSQL connection string (if using direct pooler connection)
DATABASE_URL=
